{
  "name": "flash-card",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web",
    "build": "expo export --platform web",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run",
    "knip": "knip",
    "check": "tsc && knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.8",
    "expo-router": "~55.0.7",
    "jose": "^6.2.11",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-web": "^0.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^25.0.0",
    "knip": "^5.83.1",
    "typescript": "~5.9.2",
    "vitest": "^2.1.0"
  }
}