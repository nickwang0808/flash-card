  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH expo start --web",
    "build": "expo export --platform web",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "validate:schema": "vitest run tests/unit/schema-validation.test.ts",
    "knip": "knip",
    "check": "tsc && knip",
    "seed": "npx tsx scripts/seed-test-repo.ts seed",
    "seed:reset": "npx tsx scripts/seed-test-repo.ts reset",
    "seed:status": "npx tsx scripts/seed-test-repo.ts status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "gen": "npx supabase gen types typescript --local > src/types/supabase.ts",
    "gen:prod": "npx supabase gen types typescript --project-id qfycxymncxuyexmwasgf > src/types/supabase.ts"
  },
