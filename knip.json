{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "**/*.integration.test.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "supabase/**/*.{ts,tsx}"],
  "vitest": {
    "config": ["vitest.config.ts", "vitest.integration.config.ts"]
  },
  "ignoreDependencies": ["tailwindcss", "nativewind", "expo-status-bar"],
  "ignoreBinaries": ["tsx"]
}