{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "**/*.integration.test.{ts,tsx}",
    "supabase/functions/api/index.ts",
    "src/cli/main.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "supabase/**/*.{ts,tsx}"],
  "vitest": {
    "config": ["vitest.config.ts", "vitest.integration.config.ts", "vitest.acceptance.config.ts", "vitest.cli-acceptance.config.ts"]
  },
  "ignoreFiles": ["src/components/ui/**"],
  "ignoreDependencies": ["expo-updates", "expo-system-ui", "@legendapp/motion", "react-aria", "react-native-worklets", "react-stately", "tailwind-variants", "@tailwindcss/postcss", "babel-plugin-module-resolver", "supabase"],
  "treatConfigHintsAsErrors": false,
  "ignoreBinaries": [],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"],
    "src/api/environment.ts": ["types"],
    "src/auth/AuthProvider.tsx": ["types"],
    "src/features/study/useStudySession.ts": ["types"],
    "src/db/client.ts": ["types"],
    "src/domain/Deck.ts": ["types"],
    "src/domain/errors.ts": ["types"],
    "src/domain/primitives.ts": ["types"],
    "src/domain/StudyQueue.ts": ["types"],
    "supabase/functions/api/router.ts": ["types"]
  }
}