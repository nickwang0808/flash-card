{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "**/*.integration.test.{ts,tsx}",
    "supabase/functions/api/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "supabase/**/*.{ts,tsx}"],
  "vitest": {
    "config": ["vitest.config.ts", "vitest.integration.config.ts"]
  },
  "ignoreDependencies": ["expo-updates", "expo-system-ui"],
  "ignoreBinaries": [],
  "ignoreIssues": {
    "src/db/client.ts": ["types"],
    "src/domain/Deck.ts": ["types"],
    "src/domain/errors.ts": ["types"],
    "src/domain/primitives.ts": ["types"],
    "src/domain/StudyQueue.ts": ["types"],
    "supabase/functions/api/router.ts": ["types"]
  }
}